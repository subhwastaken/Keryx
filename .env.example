# ⚡ Keryx Environment Configuration
# Copy to ~/.config/keryx/.env

# ─── NVIDIA Build (default — free tier) ────────────────────────────────────
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE

# ─── Transcription (STT) ────────────────────────────────────────────────────
# Options: "groq" | "nvidia" | "openai" | "local"
# "groq"   = Groq LPU Whisper Large v3 (~120ms ultra-low latency)
# "nvidia" = NVIDIA Build Parakeet/Canary model (free)
# "local"  = local whisper.cpp binary (Metal on Apple Silicon, CUDA on Windows/Linux)
TRANSCRIPTION_PROVIDER=nvidia
NVIDIA_STT_MODEL=nvidia/parakeet-ctc-1.1b

# ─── LLM Post-processing ────────────────────────────────────────────────────
# AI_POSTPROCESSING: "true" (LLM cleans fillers & polishes) | "false" (Instant STT, 0ms latency, direct paste)
AI_POSTPROCESSING=true
# Options: "groq" | "nvidia" | "openai" | "none"
LLM_PROVIDER=nvidia
NVIDIA_LLM_MODEL=meta/llama-3.3-70b-instruct

# ─── Text-to-Speech (TTS) ───────────────────────────────────────────────────
# Options: "auto" | "macos" | "nvidia" | "none"
# "auto"   = macOS native `say` on Mac, PowerShell/aplay on Windows/Linux
# "macos"  = macOS `say` command (offline, instant, free)
# "nvidia" = NVIDIA Build TTS API
# "none"   = silent mode (no TTS feedback)
TTS_PROVIDER=auto
NVIDIA_TTS_MODEL=nvidia/fastpitch-hifigan-tts
# macOS voice (used when TTS_PROVIDER=macos or auto on macOS)
MACOS_TTS_VOICE=Samantha

# ─── Hotkey Configuration ───────────────────────────────────────────────────
# Hold key to record, release to transcribe
# Options: "right_alt" | "right_shift" | "right_ctrl" | "fn"
HOTKEY=right_alt
# Double-tap interval in ms (for hands-free mode)
DOUBLE_TAP_MS=400
# Auto-stop hands-free session after N seconds
AUTO_STOP_SECS=300

# ─── Optional: other providers ──────────────────────────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=

# Local whisper.cpp binary path (used when TRANSCRIPTION_PROVIDER=local)
WHISPER_BIN=~/.config/keryx/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=~/.config/keryx/models/ggml-small.en.bin
